---
import { getCollection } from 'astro:content';
import silData from '../../data/silhouettes.json';
import human from '../../data/human.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { expandClades, isLandmark } from '../../lib/clades';

// Interactive size-comparison tool (prototype). Pick 2–5 animals; a client-side renderer draws the
// chosen silhouettes to a common scale (tail-tips aligned, feet grounded), with a 1.8 m human and a
// meter ruler. Pure static data + client JS — the same engine as the hub ScaleComparison, but the
// selection lives in the browser. The catalog grows on its own as the silhouette library fills in.
const taxa = await getCollection('taxa');
const specimens = await getCollection('specimens');
const taxaById = new Map(taxa.map((t) => [t.id, t]));
const specById = new Map(specimens.map((s) => [s.id, s]));

// Flatten silhouettes.json into a de-duplicated catalog, with a readable label per animal.
const seen = new Map<string, any>();
for (const group of Object.values(silData as Record<string, any[]>)) {
  for (const e of group) {
    if (seen.has(e.slug)) continue;
    let label = e.label;
    let taxon = '';
    const sp = specById.get(e.slug);
    if (sp) {
      const parent = taxaById.get(sp.data.taxon);
      taxon = parent?.data.taxon ?? '';
      const who = sp.data.nickname ?? sp.data.catalog;
      label = taxon ? `${taxon} — ${who}` : e.label;
    } else {
      const tx = taxaById.get(e.slug);
      if (tx) {
        taxon = tx.data.taxon;
        label = tx.data.taxon;
      }
    }
    // Facet data. A flat list of 262 chips is unusable, so each entry carries what the filters need:
    // its gallery (a guaranteed partition of the catalogue) and its FULL clade path, so sub-clade
    // filtering is derived from the data rather than hand-maintained (CLAUDE.md §5).
    const owner = sp ? taxaById.get(sp.data.taxon) : taxaById.get(e.slug);
    const gallery = owner?.data.gallery ?? '';
    const clades = owner ? expandClades(owner.data.clade) : [];
    seen.set(e.slug, {
      id: e.slug, label, taxon, gallery, clades,
      // widthM is the silhouette's true HORIZONTAL extent; lengthM is measured along the body and is
      // larger wherever posture curves the animal (raised necks, upright stances). The renderer must
      // scale by widthM or an upright taxon is drawn too wide. lengthM stays the biological label.
      lengthM: e.lengthM, widthM: e.widthM ?? e.lengthM, w: e.w, h: e.h, path: e.path,
    });
  }
}
const catalog = [...seen.values()].sort((a, b) => a.lengthM - b.lengthM);

// Only the scientific name is italic. `label` is either a bare binomial or "<binomial> — <nickname>",
// so splitting on the taxon prefix keeps "Scotty" and catalog numbers roman. The picker previously
// leaned on `::first-line`, which italicises whatever happens to fall on line one — right only until
// a name wraps.
const splitName = (a: { label: string; taxon: string }) =>
  a.taxon && a.label.startsWith(a.taxon)
    ? { sci: a.taxon, rest: a.label.slice(a.taxon.length) }
    : { sci: '', rest: a.label };

// ---- facets -----------------------------------------------------------------------------------
// Gallery chips use scientific display labels even where the slug is vernacular (CLAUDE.md §5).
const GALLERY_LABEL: Record<string, string> = {
  theropods: 'Theropoda',
  'sauropods-and-kin': 'Sauropodomorpha',
  ornithischians: 'Ornithischia',
  synapsids: 'Synapsida',
  'non-dinosaurs': 'Non-dinosaurs',
};
const galleryFacets = Object.keys(GALLERY_LABEL)
  .map((g) => ({ id: g, label: GALLERY_LABEL[g], n: catalog.filter((a) => a.gallery === g).length }))
  .filter((f) => f.n > 0);

// Sub-clade chips, derived: within each gallery, the clades carrying enough members to be worth a
// filter. Shown only once its parent gallery is active, so the second tier never crowds the first.
const SUBCLADE_MIN = 4;
const subFacets: Record<string, { id: string; n: number }[]> = {};
for (const g of galleryFacets) {
  const counts = new Map<string, number>();
  for (const a of catalog.filter((x) => x.gallery === g.id))
    for (const c of a.clades) if (isLandmark(c) && c !== g.label) counts.set(c, (counts.get(c) ?? 0) + 1);
  subFacets[g.id] = [...counts.entries()]
    .filter(([, n]) => n >= SUBCLADE_MIN)
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 10)
    .map(([id, n]) => ({ id, n }));
}

// Size brackets — a size tool should be browsable BY size, and it is how people actually look
// ("what else was about as big as a bus?"). Bounds are inclusive-low, exclusive-high.
const SIZE_BANDS = [
  { id: 'xs', label: 'Under 1 m', lo: 0, hi: 1 },
  { id: 's', label: '1–3 m', lo: 1, hi: 3 },
  { id: 'm', label: '3–10 m', lo: 3, hi: 10 },
  { id: 'l', label: '10–20 m', lo: 10, hi: 20 },
  { id: 'xl', label: '20 m +', lo: 20, hi: Infinity },
].map((b) => ({ ...b, n: catalog.filter((a) => a.lengthM >= b.lo && a.lengthM < b.hi).length }))
  .filter((b) => b.n > 0);

// Default selection: a clear small-vs-large contrast, falling back to the extremes.
const prefer = ['scotty', 'diplodocus-carnegii'].filter((id) => seen.has(id));
const defaultSel =
  prefer.length >= 2
    ? prefer
    : [catalog[0]?.id, catalog[catalog.length - 1]?.id].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i);

// ---- header silhouette group -------------------------------------------------------------------
// The search page floats a single Sue behind its heading; here the banner should DEMONSTRATE the tool,
// so it shows a group at true common scale — built with the same widthM maths the renderer uses, since
// a hero advertising scale comparison must not fake its own proportions.
//
// Two deliberate departures from the hub convention:
//  - the humans stand under the rex's jaw rather than off to the right. That costs no extra width, so
//    the banner is ~11% more compact, and the far-left space under the head is the one place a 1.8 m
//    figure reads fully clear of the silhouette. Under the neck crowds them; under the belly merges
//    them into the body (at one flat colour, overlap is loss — unlike the tool's blended fills).
//  - opacity .18, not the search page's .08: that value was tuned for ONE large silhouette, and a
//    group loses the small figures at it — which are exactly the point of a scale comparison.
const HERO_SET = ['sue', 'struthiomimus-altus', 'protoceratops-andrewsi'];
const HERO_W = 1400;
const heroItems = HERO_SET.map((s) => seen.get(s)).filter(Boolean).sort((a, b) => b.widthM - a.widthM);
let heroSvg = '';
if (heroItems.length) {
  const pxm = HERO_W / Math.max(...heroItems.map((i) => i.widthM));
  const drawn = heroItems.map((it) => {
    const s = (pxm * it.widthM) / it.w;
    return { it, s, sw: it.w * s, sh: it.h * s };
  });
  const hScale = (1.8 * pxm) / human.h;
  const hH = human.h * hScale;
  const H = Math.ceil(Math.max(...drawn.map((d) => d.sh), hH)) + 8;
  const parts = drawn.map(
    (d) =>
      `<path d="${d.it.path}" transform="translate(${(HERO_W - d.sw).toFixed(1)} ${(H - 4 - d.sh).toFixed(1)}) scale(${d.s.toFixed(5)})"/>`,
  );
  parts.push(
    `<g transform="translate(${(HERO_W * 0.02).toFixed(1)} ${(H - 4 - hH).toFixed(1)}) scale(${hScale.toFixed(5)})"><path d="${human.path}"/></g>`,
  );
  heroSvg = `<svg viewBox="0 0 ${HERO_W} ${H}" aria-hidden="true" focusable="false"><g fill="currentColor" fill-rule="evenodd">${parts.join('')}</g></svg>`;
}

// ⛔ UNSHIPPED — REMOVE BOTH HALVES OF THIS AT LAUNCH:
//   1. the <meta robots> below, and
//   2. the `/compare/` exclusion in astro.config.mjs's sitemap filter.
// The page is live and returns 200, and being unlinked is NOT protection: it was listed in
// sitemap-0.xml, which was submitted to Search Console, so Google had been invited to crawl it.
// noindex (not a robots.txt Disallow) is the right tool — a Disallow would stop the crawl before
// Google could read the directive, which is the same trap noted in functions/_middleware.js.
const UNSHIPPED = true;

const title = 'Size comparison — build your own | Skeletal Drawing';
const description =
  'Pick any two to five extinct animals and see them drawn to a single scale, with a human for reference — measured from the same skeletal reconstructions used across the site.';
---

<BaseLayout title={title} description={description}>
  {UNSHIPPED && (
    <Fragment slot="head">
      <meta name="robots" content="noindex, follow" />
    </Fragment>
  )}
  <main class="wrap">
    <div class="head-band">
    {heroSvg && <div class="hero-sil" aria-hidden="true" set:html={heroSvg} />}
    <header class="head">
      <p class="eyebrow">Tools</p>
      <h1 class="display">Size comparison</h1>
      <p class="intro">
        Pick two to five animals and see them drawn to a single scale — tails aligned, feet on a common
        ground line, with a 1.8&nbsp;m human for reference. Every silhouette comes from the measured
        reconstructions used across the site. <span class="beta">More animals are added as the library grows.</span>
      </p>
    </header>
    </div>

    {/* The plate leads. It used to sit last, and the chooser above it ran past a viewport on every
        breakpoint — y≈871 on desktop, y≈1079 on a 812px phone — so the page opened on a form rather
        than on the thing it makes. Capping the picker height was not enough; the header, filters,
        search, count and controls still stacked past the fold. Result first, controls beneath it,
        chooser last: every adjustment now changes something already on screen. */}
    <section class="stage-sec">
      <div class="stage" id="stage"></div>
      <p class="hint" id="hint">Choose animals below to build a comparison.</p>
      <p class="readout" id="readout" hidden></p>
      {/* Shown only when a selected animal is posed enough for the ruler to read short — a general
          note on a plate where it does not apply is just noise. */}
      <p class="posenote" id="posenote" hidden>
        Lengths are measured along the body, so an animal with a raised neck or a curving tail covers
        less ground than its full length.
      </p>
      <div class="legend" id="legend"></div>
    </section>

    <div class="controls">
      <label class="toggle"><input type="checkbox" id="human-toggle" checked /> Human for scale</label>
      <span class="spacer"></span>
      <button type="button" class="ctl" id="clear">Clear</button>
      <button type="button" class="ctl" id="copy">Copy link</button>
      <span class="copied" id="copied" hidden>Link copied</span>
    </div>

    <section class="picker-sec" aria-label="Choose animals">
      {/* Selected row sits ABOVE the filters and never filters out. Without it, narrowing the list
          would appear to discard picks that are still active — the single worst failure mode of a
          filtered multi-select. */}
      <div class="chosen-row" id="chosen-row" hidden>
        <span class="chosen-lbl">Comparing</span>
        <div class="chosen" id="chosen"></div>
      </div>

      {/* Mobile only: the facet rows cost ~180px at phone width, pushing the comparison to y≈1078 —
          past a whole screen of chooser before the page does its job. Search stays out, because it is
          how someone arrives with a specific animal in mind. Desktop shows everything (113px is cheap
          and hiding the main affordance would hurt discovery more than it saves). */}
      <button type="button" class="filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="facets">
        Filters<span class="ft-caret" aria-hidden="true">▾</span>
      </button>

      <div class="filters">
        <label class="search">
          <span class="vh">Search animals</span>
          <input type="search" id="q" placeholder={`Search ${catalog.length} animals…`} autocomplete="off" spellcheck="false" />
        </label>

        <div class="facets" id="facets">
        <div class="facet-row" role="group" aria-label="Filter by group">
          <button type="button" class="facet on" data-facet="gallery" data-val="" aria-pressed="true">All</button>
          {galleryFacets.map((g) => (
            <button type="button" class="facet" data-facet="gallery" data-val={g.id} aria-pressed="false">
              {g.label}<span class="facet-n">{g.n}</span>
            </button>
          ))}
        </div>

        {galleryFacets.map((g) => (
          <div class="facet-row sub" data-sub={g.id} hidden role="group" aria-label={`Filter within ${g.label}`}>
            <button type="button" class="facet sub-all on" data-facet="clade" data-val="" aria-pressed="true">All {g.label}</button>
            {subFacets[g.id].map((c) => (
              <button type="button" class="facet" data-facet="clade" data-val={c.id} aria-pressed="false">
                {c.id}<span class="facet-n">{c.n}</span>
              </button>
            ))}
          </div>
        ))}

        <div class="facet-row" role="group" aria-label="Filter by size">
          <button type="button" class="facet on" data-facet="size" data-val="" aria-pressed="true">Any size</button>
          {SIZE_BANDS.map((b) => (
            <button type="button" class="facet" data-facet="size" data-val={b.id} aria-pressed="false">
              {b.label}<span class="facet-n">{b.n}</span>
            </button>
          ))}
        </div>
        </div>
      </div>

      <p class="count" id="count" aria-live="polite"></p>
      {/* At the cap every unselected chip disables itself. Without a word of explanation that reads
          as the page breaking, not as a limit — 259 controls going dead at once. */}
      <p class="cap-note" id="cap-note" role="status" hidden>Five at a time — remove one to add another.</p>

      <div class="picker" id="picker">
        {catalog.map((a) => (
          <button
            type="button"
            class="chip"
            data-id={a.id}
            data-gallery={a.gallery}
            data-clades={a.clades.join('|')}
            data-len={a.lengthM}
            data-name={`${a.label} ${a.taxon}`.toLowerCase()}
            aria-pressed="false"
          >
            <span class="chip-name">
              {splitName(a).sci && <em>{splitName(a).sci}</em>}{splitName(a).rest}
            </span>
            <span class="chip-len">{a.lengthM} m</span>
          </button>
        ))}
      </div>
    </section>

    <noscript>
      <p class="noscript">This comparison tool needs JavaScript. Every animal is also shown to scale on its own page and on the genus hubs.</p>
    </noscript>
  </main>
</BaseLayout>

<script type="application/json" id="catalog" is:inline set:html={JSON.stringify(catalog)}></script>
<script type="application/json" id="cfg" is:inline set:html={JSON.stringify({ def: defaultSel })}></script>
<script type="application/json" id="human" is:inline set:html={JSON.stringify(human)}></script>

<script is:inline>
  (() => {
    const catalog = JSON.parse(document.getElementById('catalog').textContent);
    const cfg = JSON.parse(document.getElementById('cfg').textContent);
    const human = JSON.parse(document.getElementById('human').textContent);
    const byId = Object.fromEntries(catalog.map((a) => [a.id, a]));
    const PXM = 100,
      MAX = 5;
    // Shared with ScaleComparison.astro — keep in step. Hue/sat drive the lightness ramp; the
    // coverage band maps "how much of the shape behind do I cover" onto fill opacity, anchored to
    // length difference via coverage ~= (length ratio)^2: .90 ~ 5% shorter, .50 ~ 29% shorter.
    const RAMP_HUE = 34, RAMP_SAT = 58;
    const OP_BLEND = 0.75, OP_SOLID = 1, COVER_LO = 0.5, COVER_HI = 0.9;
    // Human scale reference: the owner's adult + child silhouette, adult scaled to 1.8 m.
    const humanH = 180,
      humanScale = humanH / human.h,
      humanW = +(human.w * humanScale).toFixed(1);

    const stage = document.getElementById('stage');
    const legend = document.getElementById('legend');
    const hint = document.getElementById('hint');
    const readout = document.getElementById('readout');
    const posenote = document.getElementById('posenote');
    const capNote = document.getElementById('cap-note');
    const humanToggle = document.getElementById('human-toggle');
    const chips = [...document.querySelectorAll('.chip')];
    let selected = [];

    // Mirror of the server-side splitName: italicise the binomial only, so "— Scotty" and catalog
    // numbers stay roman. Labels are built from our own content, but escape anyway — this is the one
    // place catalog text becomes innerHTML.
    const esc = (t) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
    const nameHtml = (a) =>
      a.taxon && a.label.startsWith(a.taxon)
        ? `<em>${esc(a.taxon)}</em>${esc(a.label.slice(a.taxon.length))}`
        : esc(a.label);

    const fromUrl = () => {
      const p = new URLSearchParams(location.search).get('ids');
      return p ? p.split(',').filter((id) => byId[id]).slice(0, MAX) : [];
    };
    const toUrl = () => {
      const u = new URL(location.href);
      if (selected.length) u.searchParams.set('ids', selected.join(','));
      else u.searchParams.delete('ids');
      history.replaceState(null, '', u);
    };
    // ---- filtering ----------------------------------------------------------------------------
    // 262 chips in one flat list is unusable, so the picker is filtered rather than paged: search,
    // group, sub-clade and size all narrow the SAME list. Chips are hidden, never removed, so the
    // selection is untouched by filtering and a cleared filter restores instantly.
    const SIZE_BANDS = { xs: [0, 1], s: [1, 3], m: [3, 10], l: [10, 20], xl: [20, Infinity] };
    const q = document.getElementById('q');
    const countEl = document.getElementById('count');
    const chosenRow = document.getElementById('chosen-row');
    const chosenEl = document.getElementById('chosen');
    const filter = { text: '', gallery: '', clade: '', size: '' };

    const applyFilter = () => {
      const t = filter.text.trim().toLowerCase();
      let shown = 0;
      for (const c of chips) {
        const band = filter.size ? SIZE_BANDS[filter.size] : null;
        const len = +c.dataset.len;
        const ok =
          (!t || c.dataset.name.includes(t)) &&
          (!filter.gallery || c.dataset.gallery === filter.gallery) &&
          (!filter.clade || ('|' + c.dataset.clades + '|').includes('|' + filter.clade + '|')) &&
          (!band || (len >= band[0] && len < band[1]));
        c.hidden = !ok;
        if (ok) shown++;
      }
      // The sub-clade row only exists once its parent group is chosen — otherwise the second tier
      // would present ~40 chips before the reader has narrowed anything.
      for (const row of document.querySelectorAll('.facet-row.sub'))
        row.hidden = row.dataset.sub !== filter.gallery;
      const active = filter.text || filter.gallery || filter.clade || filter.size;
      countEl.textContent = active
        ? `${shown} of ${chips.length} animals` + (shown === 0 ? ' — try widening the filters' : '')
        : `${chips.length} animals`;
    };

    const setFacet = (kind, val) => {
      filter[kind] = val;
      if (kind === 'gallery') filter.clade = ''; // sub-clades belong to a group; changing group clears them
      for (const b of document.querySelectorAll('.facet')) {
        if (b.dataset.facet !== kind) continue;
        if (kind === 'clade' && b.closest('.facet-row.sub')?.dataset.sub !== filter.gallery) continue;
        const on = (b.dataset.val || '') === val;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      if (kind === 'gallery')
        for (const b of document.querySelectorAll('.facet[data-facet="clade"]')) {
          const on = !b.dataset.val;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', String(on));
        }
      applyFilter();
    };

    // Selected chips are mirrored above the filters, each removable, so a narrowed list never hides
    // what is currently being compared.
    const renderChosen = () => {
      chosenRow.hidden = selected.length === 0;
      chosenEl.innerHTML = selected
        .map((id) => {
          const a = byId[id];
          return a
            ? `<button type="button" class="chosen-chip" data-drop="${id}" title="Remove ${a.label}">` +
              `${a.label}<span class="x" aria-hidden="true">×</span>` +
              `<span class="vh">remove</span></button>`
            : '';
        })
        .join('');
    };

    const syncChips = () => {
      const atCap = selected.length >= MAX;
      chips.forEach((c) => {
        const on = selected.includes(c.dataset.id);
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', String(on));
        c.disabled = !on && atCap;
      });
      capNote.hidden = !atCap;
    };

    function render() {
      syncChips();
      renderChosen();
      const items = selected.map((id) => byId[id]).filter(Boolean).sort((a, b) => b.lengthM - a.lengthM);
      if (!items.length) {
        stage.innerHTML = '';
        legend.innerHTML = '';
        hint.hidden = false;
        // Reset here too: this branch returns early, so without it Clear leaves the previous
        // comparison's sentence sitting under an empty plate.
        readout.hidden = true;
        posenote.hidden = true;
        return;
      }
      hint.hidden = true;
      const showHuman = humanToggle.checked;
      const padL = 16,
        padT = 16;
      // Scale by the silhouette's horizontal extent, not its along-body length — otherwise an
      // upright taxon (raised neck, therizinosaur, bird) is drawn as wide as it is long. sw then
      // equals PXM * widthM, so the metre ruler below stays exact.
      const scaled = items.map((it, idx) => {
        const s = (PXM * it.widthM) / it.w;
        return { it, idx, s, sw: it.w * s, sh: it.h * s };
      });
      const maxLen = Math.max(...items.map((i) => i.lengthM)); // biological, for the label
      const maxSW = Math.max(...scaled.map((d) => d.sw));      // geometric, for the layout
      const maxSH = Math.max(...scaled.map((d) => d.sh), showHuman ? 180 : 0);
      const guideX = padL + maxSW,
        groundY = padT + maxSH;
      const humanGap = 40,
        humanX = guideX + humanGap;
      // Ruler spans the drawn extent, not the biological length — otherwise the ticks run off the
      // left edge whenever the widest animal is posture-shortened (widthM < lengthM).
      const meters = Math.floor(maxSW / PXM);
      const rulerY = groundY + 20;
      const rightPad = (showHuman ? humanGap + humanW : 0) + 30;
      const vbW = Math.round(guideX + rightPad),
        vbH = Math.round(rulerY + 22);

      let s = `<svg viewBox="0 0 ${vbW} ${vbH}" role="img" aria-label="Scale comparison of ${items.length} animals, largest ${maxLen} meters">`;
      s += `<line x1="${padL}" y1="${groundY}" x2="${showHuman ? humanX + humanW : guideX}" y2="${groundY}" class="c-ground"/>`;
      for (let m = 0; m <= meters; m++) {
        const x = guideX - m * PXM;
        const major = m % 5 === 0;
        s += `<line x1="${x}" y1="${groundY}" x2="${x}" y2="${groundY + (major ? 8 : 4)}" class="c-tick${major ? ' major' : ''}"/>`;
        if (major) s += `<text x="${x}" y="${rulerY + 6}" class="c-ticklabel">${m}</text>`;
      }
      // "meters of ground covered", not "meters from tail tip": the ruler measures the DRAWN
      // horizontal extent, which for a raised-neck sauropod falls well short of the quoted along-body
      // length (Patagotitan: 28 m long, 22.4 m of ground). Naming what it actually measures stops the
      // ruler from looking like it contradicts the legend. See the pose note below the plate.
      s += `<text x="${guideX - meters * PXM}" y="${rulerY + 19}" class="c-unit">meters of ground covered</text>`;
      // Gold-tint ramp + adaptive opacity, matching ScaleComparison.astro (the hub treatment is
      // canonical). Largest = lightest and painted first (back) -> smallest = darkest and in front.
      // Opacity comes from how much of the shape BEHIND each silhouette it covers: near-equal sizes
      // must blend or the one behind disappears; a clearly smaller animal hides almost nothing and
      // reads better solid. See ScaleComparison for the coverage<->length-difference mapping.
      let smallestBehind = Infinity;
      const painted = scaled.map((d) => {
        const t = scaled.length > 1 ? d.idx / (scaled.length - 1) : 0.4;
        const L = Math.round(68 - t * 38);
        const area = d.sw * d.sh;
        const coverage = smallestBehind === Infinity ? 0 : Math.min(area / smallestBehind, 1);
        smallestBehind = Math.min(smallestBehind, area);
        const k = Math.min(Math.max((coverage - COVER_LO) / (COVER_HI - COVER_LO), 0), 1);
        const fillOpacity = +(OP_SOLID + (OP_BLEND - OP_SOLID) * k).toFixed(3);
        return {
          ...d, fillOpacity,
          fill: `hsl(${RAMP_HUE} ${RAMP_SAT}% ${L}%)`,
          stroke: `hsl(${RAMP_HUE} ${RAMP_SAT + 8}% ${Math.max(L - 18, 16)}%)`,
          swatch: `hsl(${RAMP_HUE} ${RAMP_SAT}% ${L}% / ${fillOpacity})`,
        };
      });
      painted.forEach((d) => {
        const tx = `translate(${(guideX - d.sw).toFixed(1)} ${(groundY - d.sh).toFixed(1)}) scale(${d.s.toFixed(4)})`;
        s += `<path d="${d.it.path}" transform="${tx}" fill="${d.fill}" fill-opacity="${d.fillOpacity}" fill-rule="evenodd" stroke="${d.stroke}" stroke-width="1.2" stroke-opacity="0.9" vector-effect="non-scaling-stroke"/>`;
      });
      s += `<line x1="${guideX}" y1="${padT}" x2="${guideX}" y2="${groundY}" class="c-guide"/>`;
      if (showHuman) {
        s += `<g transform="translate(${humanX} ${groundY - humanH}) scale(${humanScale.toFixed(4)})"><path d="${human.path}" class="c-human"/></g>`;
        s += `<text x="${humanX + humanW / 2}" y="${groundY + 14}" class="c-humanlabel" text-anchor="middle">1.8 m</text>`;
      }
      s += `</svg>`;
      stage.innerHTML = s;
      // Swatches carry the same alpha the plate renders, on the same background, so the key shows
      // what is actually drawn rather than the fill at full strength.
      legend.innerHTML = painted
        .map(
          (d) =>
            `<span class="leg"><span class="leg-sw" style="background:${d.swatch};border:1px solid ${d.stroke}"></span><span class="leg-name">${nameHtml(d.it)}</span><span class="leg-len">${d.it.lengthM} m</span></span>`,
        )
        .join('');

      // Stated finding, not just a picture: the drawing shows the difference, this names it — and it
      // gives an otherwise all-SVG page real text to index.
      if (items.length >= 2) {
        const big = items[0], small = items[items.length - 1];
        const ratio = big.lengthM / small.lengthM;
        // Kept as a string: +(2.047).toFixed(1) coerces back to 2 and prints "2×", dropping the one
        // decimal that says how precise the claim is. Above 10× the decimal is false precision.
        const n = ratio >= 10 ? String(Math.round(ratio)) : ratio.toFixed(1);
        readout.innerHTML =
          ratio >= 1.05
            ? `${nameHtml(big)} is ${n}× the length of ${nameHtml(small)}.`
            : `${nameHtml(big)} and ${nameHtml(small)} are within a few percent of the same length.`;
        readout.hidden = false;
      } else {
        readout.hidden = true;
      }

      // Only surface the pose note when something on the plate actually demonstrates it.
      posenote.hidden = !items.some((it) => it.widthM / it.lengthM < 0.95);
    }

    const toggle = (id) => {
      const i = selected.indexOf(id);
      if (i >= 0) selected.splice(i, 1);
      else {
        if (selected.length >= MAX) return;
        selected.push(id);
      }
      toUrl();
      render();
    };

    chips.forEach((c) => c.addEventListener('click', () => toggle(c.dataset.id)));
    humanToggle.addEventListener('change', render);

    q.addEventListener('input', () => { filter.text = q.value; applyFilter(); });

    // Facets collapse on phones only. `hidden` is set from JS rather than the markup so the panel is
    // open by default for anyone without JS, and desktop CSS ignores the attribute entirely.
    const ftog = document.getElementById('filters-toggle');
    const facets = document.getElementById('facets');
    const isPhone = () => matchMedia('(max-width: 700px)').matches;
    const syncFacets = (open) => {
      ftog.setAttribute('aria-expanded', String(open));
      facets.hidden = isPhone() && !open;
    };
    ftog.addEventListener('click', () => syncFacets(ftog.getAttribute('aria-expanded') !== 'true'));
    // A viewport crossing the breakpoint must not strand the panel hidden on desktop.
    matchMedia('(max-width: 700px)').addEventListener('change', () =>
      syncFacets(ftog.getAttribute('aria-expanded') === 'true'));
    syncFacets(false);
    for (const b of document.querySelectorAll('.facet'))
      b.addEventListener('click', () => setFacet(b.dataset.facet, b.dataset.val || ''));
    // Delegated: the chosen row is re-rendered on every change, so per-chip listeners would leak.
    chosenEl.addEventListener('click', (e) => {
      const b = e.target.closest('[data-drop]');
      if (b) toggle(b.dataset.drop);
    });
    document.getElementById('clear').addEventListener('click', () => {
      selected = [];
      toUrl();
      render();
    });
    document.getElementById('copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        const c = document.getElementById('copied');
        c.hidden = false;
        setTimeout(() => (c.hidden = true), 1600);
      } catch (e) {}
    });

    selected = fromUrl();
    if (!selected.length) selected = (cfg.def || []).filter((id) => byId[id]).slice(0, MAX);
    applyFilter(); // seeds the count and hides the sub-clade rows before first paint
    render();
  })();
</script>

<style>
  .wrap { max-width: var(--measure-max); margin: 0 auto; padding: 44px var(--pad-side) 0; }
  .head { max-width: 64ch; margin-bottom: 28px; position: relative; z-index: 1; }

  /* Silhouette group behind the heading — a demonstration of the tool, not decoration.
     It lives in its own FULL-WIDTH band rather than inside .head, because .head is capped at 64ch and
     a group positioned within it has nowhere to sit but on top of the copy. The band clips, so the
     tail can run off the right without widening the document (CLAUDE.md §3: no horizontal scroll).
     Hidden below 1000px: narrower than that there is no room clear of the text column, and at phone
     widths the small members — the whole point — are illegible anyway. */
  .head-band { position: relative; overflow: hidden; }
  .hero-sil { position: absolute; inset: 0; pointer-events: none; color: var(--ink); z-index: 0; }
  /* Anchored to the band's right edge and SIZED TO THE CLEAR ZONE rather than clipped. The small
     members sit at the tail end (they are tail-aligned, as the tool draws them), so clipping the
     right-hand side would remove exactly the animals that make the point — leaving a lone rex, which
     is the search page's banner, not this one's. `100% - 600px` reserves the 64ch copy column. */
  .hero-sil :global(svg) {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    width: min(540px, calc(100% - 600px)); height: auto; opacity: .18;
  }
  @media (max-width: 1100px) { .hero-sil { display: none; } }
  .eyebrow {
    margin: 0 0 10px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .22em;
    text-transform: uppercase; color: var(--slate);
  }
  .display { margin: 0; font-style: italic; font-weight: 500; font-size: clamp(38px, 6.5vw, 64px); line-height: 1.0; letter-spacing: -.015em; }
  .intro { margin: 18px 0 0; font-size: 18px; line-height: 1.6; color: var(--ink); max-width: 62ch; }
  .beta { color: var(--slate); }

  /* picker */
  .picker-sec { border-top: 1px solid var(--hair); padding-top: 22px; }
  /* ---- selection + filters ---- */
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .chosen-row {
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    margin: 0 0 18px; padding-bottom: 16px; border-bottom: 1px solid var(--hair);
  }
  .chosen-lbl {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--slate); flex: 0 0 auto;
  }
  .chosen { display: flex; flex-wrap: wrap; gap: 8px; }
  .chosen-chip {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font: inherit;
