      letter-spacing: .1em; text-transform: uppercase; color: var(--slate);
      background: transparent; border: 1px solid var(--hair-strong); border-radius: 999px;
      padding: 7px 14px;
    }
    .filters-toggle[aria-expanded='true'] { color: var(--ink); border-color: var(--accent); }
    .filters-toggle[aria-expanded='true'] .ft-caret { transform: rotate(180deg); }
