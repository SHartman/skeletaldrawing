  .search input {
    width: 100%; max-width: 420px; font-family: var(--font-serif); font-size: 16px;
    color: var(--ink); background: var(--plate); border: 1px solid var(--hair-strong);
    border-radius: 4px; padding: 9px 12px;
  }
  .search input:focus {
    outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-weak);
  }
  .facet-row { display: flex; flex-wrap: wrap; gap: 7px; }
  /* An author `display` beats the UA's `[hidden] { display: none }`, so hidden rows would still
     occupy their full height — 234px of invisible sub-clade rows before this. Same trap as .chip. */
  .facet-row[hidden], .chosen-row[hidden] { display: none; }
