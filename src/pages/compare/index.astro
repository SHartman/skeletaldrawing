---
import { getCollection } from 'astro:content';
import silData from '../../data/silhouettes.json';
import human from '../../data/human.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { expandClades, isLandmark } from '../../lib/clades';
import { COMPARE_LIVE } from '../../lib/flags.mjs';

// Interactive size-comparison tool (prototype). Pick 2–5 animals; a client-side renderer draws the
// chosen silhouettes to a common scale (tail-tips aligned, feet grounded), with a 1.8 m human and a
// meter ruler. Pure static data + client JS — the same engine as the hub ScaleComparison, but the
// selection lives in the browser. The catalog grows on its own as the silhouette library fills in.
const taxa = await getCollection('taxa');
const specimens = await getCollection('specimens');
const taxaById = new Map(taxa.map((t) => [t.id, t]));
const specById = new Map(specimens.map((s) => [s.id, s]));

// Longest-first, so "maiasaura-peeblesorum-adult-skeletal" resolves to the two-word taxon rather than
// stopping at a shorter id that happens to share its opening.
const taxonIdsByLength = taxa.map((t) => t.id).sort((a, b) => b.length - a.length);

// Flatten silhouettes.json into a de-duplicated catalog, with a readable label per animal.
const seen = new Map<string, any>();
for (const group of Object.values(silData as Record<string, any[]>)) {
  for (const e of group) {
    if (seen.has(e.slug)) continue;
    let label = e.label;
    let taxon = '';
    const sp = specById.get(e.slug);
    if (sp) {
      const parent = taxaById.get(sp.data.taxon);
      taxon = parent?.data.taxon ?? '';
      const who = sp.data.nickname ?? sp.data.catalog;
      // Parenthesised, not em-dashed. The label is read as running prose in the plate's title
      // ("Tyrannosaurus rex (Scotty) is 1.5× the length of…"), where a mid-sentence em dash reads as
      // an aside rather than as part of the subject. It also matches SpecimenPage, which already
      // parenthesises the nickname. `who` may be a catalog number, so no quotes around it.
      label = taxon ? `${taxon} (${who})` : e.label;
    } else {
      const tx = taxaById.get(e.slug);
      if (tx) {
        taxon = tx.data.taxon;
        label = tx.data.taxon;
      } else {
        // Growth-series stages. Their key is a silhouette FILENAME, not a taxon or specimen id, so
        // neither lookup above matches and the label stays whatever the stage was called — "Adult",
        // "Hatchling". That reads fine on the taxon's own page, where the genus is the heading, but in
        // a catalogue of 270 animals it identifies nothing, and the plate title would have read
        // "Adult is 15× the length of Hatchling". Recover the parent from the slug prefix.
        const parentId = taxonIdsByLength.find((id) => e.slug.startsWith(`${id}-`));
        const parent = parentId ? taxaById.get(parentId) : null;
        if (parent) {
          taxon = parent.data.taxon;
          const stage = e.label.charAt(0).toLowerCase() + e.label.slice(1); // keeps "TTUP 9002" cased
          label = `${taxon} (${stage})`;
        }
      }
    }
    // Facet data. A flat list of 262 chips is unusable, so each entry carries what the filters need:
    // its gallery (a guaranteed partition of the catalogue) and its FULL clade path, so sub-clade
    // filtering is derived from the data rather than hand-maintained (CLAUDE.md §5).
    const owner = sp ? taxaById.get(sp.data.taxon) : taxaById.get(e.slug);
    const gallery = owner?.data.gallery ?? '';
    const clades = owner ? expandClades(owner.data.clade) : [];
    seen.set(e.slug, {
      id: e.slug, label, taxon, gallery, clades,
      // widthM is the silhouette's true HORIZONTAL extent; lengthM is measured along the body and is
      // larger wherever posture curves the animal (raised necks, upright stances). The renderer must
      // scale by widthM or an upright taxon is drawn too wide. lengthM stays the biological label.
      lengthM: e.lengthM, widthM: e.widthM ?? e.lengthM, w: e.w, h: e.h, path: e.path,
    });
  }
}
const catalog = [...seen.values()].sort((a, b) => a.lengthM - b.lengthM);

// Only the scientific name is italic. `label` is either a bare binomial or "<binomial> — <nickname>",
// so splitting on the taxon prefix keeps "Scotty" and catalog numbers roman. The picker previously
// leaned on `::first-line`, which italicises whatever happens to fall on line one — right only until
// a name wraps.
const splitName = (a: { label: string; taxon: string }) =>
  a.taxon && a.label.startsWith(a.taxon)
    ? { sci: a.taxon, rest: a.label.slice(a.taxon.length) }
    : { sci: '', rest: a.label };

// ---- facets -----------------------------------------------------------------------------------
// Gallery chips use scientific display labels even where the slug is vernacular (CLAUDE.md §5).
const GALLERY_LABEL: Record<string, string> = {
  theropods: 'Theropoda',
  'sauropods-and-kin': 'Sauropodomorpha',
  ornithischians: 'Ornithischia',
  synapsids: 'Synapsida',
  'non-dinosaurs': 'Non-dinosaurs',
};
const galleryFacets = Object.keys(GALLERY_LABEL)
  .map((g) => ({ id: g, label: GALLERY_LABEL[g], n: catalog.filter((a) => a.gallery === g).length }))
  .filter((f) => f.n > 0);

// Sub-clade chips, derived: within each gallery, the clades carrying enough members to be worth a
// filter. Shown only once its parent gallery is active, so the second tier never crowds the first.
const SUBCLADE_MIN = 4;
const subFacets: Record<string, { id: string; n: number }[]> = {};
for (const g of galleryFacets) {
  const counts = new Map<string, number>();
  for (const a of catalog.filter((x) => x.gallery === g.id))
    for (const c of a.clades) if (isLandmark(c) && c !== g.label) counts.set(c, (counts.get(c) ?? 0) + 1);
  subFacets[g.id] = [...counts.entries()]
    .filter(([, n]) => n >= SUBCLADE_MIN)
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 10)
    .map(([id, n]) => ({ id, n }));
}

// Size brackets — a size tool should be browsable BY size, and it is how people actually look
// ("what else was about as big as a bus?"). Bounds are inclusive-low, exclusive-high.
const SIZE_BANDS = [
  { id: 'xs', label: 'Under 1 m', lo: 0, hi: 1 },
  { id: 's', label: '1–3 m', lo: 1, hi: 3 },
  { id: 'm', label: '3–10 m', lo: 3, hi: 10 },
  { id: 'l', label: '10–20 m', lo: 10, hi: 20 },
  { id: 'xl', label: '20 m +', lo: 20, hi: Infinity },
].map((b) => ({ ...b, n: catalog.filter((a) => a.lengthM >= b.lo && a.lengthM < b.hi).length }))
  .filter((b) => b.n > 0);

// Default selection: a clear small-vs-large contrast, falling back to the extremes.
const prefer = ['scotty', 'diplodocus-carnegii'].filter((id) => seen.has(id));
const defaultSel =
  prefer.length >= 2
    ? prefer
    : [catalog[0]?.id, catalog[catalog.length - 1]?.id].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i);

// The scale figure is an adult and a child in one merged outline, so a label centred under the pair
// appears to caption both — and it is the adult who measures 1.8 m. Locate the adult by taking the
// horizontal centre of whatever reaches the top of the figure; derived rather than hardcoded so it
// still lands correctly if the artwork is ever redrawn.
const humanPts: number[][] = [];
{
  const nums = human.path.match(/-?\d+(?:\.\d+)?/g)?.map(Number) ?? [];
  for (let i = 0; i + 1 < nums.length; i += 2) humanPts.push([nums[i], nums[i + 1]]);
}
const headXs = humanPts.filter((p) => p[1] < 0.12 * human.h).map((p) => p[0]);
const adultCx = headXs.length ? (Math.min(...headXs) + Math.max(...headXs)) / 2 / human.w : 0.5;

// ---- the plate's title -------------------------------------------------------------------------
// The comparison sentence is the heading above the plate, so it is rendered server-side for the
// default selection rather than painted in by script: an empty heading on first paint would shift the
// layout under it, and the page's one line of plain-language finding should exist in the HTML.
// The client rebuilds this on every change — KEEP THE TWO WORDINGS IN STEP (see `render`).
const esc = (t: string) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c] as string);
const nameMarkup = (a: any) => {
  const { sci, rest } = splitName(a);
  return sci ? `<em>${esc(sci)}</em>${esc(rest)}` : esc(rest);
};
const defItems = defaultSel.map((id) => seen.get(id)).filter(Boolean).sort((a, b) => b.lengthM - a.lengthM);
let defaultReadout = '';
if (defItems.length >= 2) {
  const big = defItems[0];
  const small = defItems[defItems.length - 1];
  const r = big.lengthM / small.lengthM;
  const n = r >= 10 ? String(Math.round(r)) : r.toFixed(1);
  // No terminal period — it is a title, not a sentence.
  defaultReadout =
    r >= 1.05
      ? `${nameMarkup(big)} is ${n}× the length of ${nameMarkup(small)}`
      : `${nameMarkup(big)} and ${nameMarkup(small)} are within a few percent of the same length`;
}

// ---- header silhouette group -------------------------------------------------------------------
// The search page floats a single Sue behind its heading; here the banner should DEMONSTRATE the tool,
// so it shows a group at true common scale — built with the same widthM maths the renderer uses, since
// a hero advertising scale comparison must not fake its own proportions.
//
// Two deliberate departures from the hub convention:
//  - the humans stand under the rex's jaw rather than off to the right. That costs no extra width, so
//    the banner is ~11% more compact, and the far-left space under the head is the one place a 1.8 m
//    figure reads fully clear of the silhouette. Under the neck crowds them; under the belly merges
//    them into the body (at one flat colour, overlap is loss — unlike the tool's blended fills).
//  - opacity .18, not the search page's .08: that value was tuned for ONE large silhouette, and a
//    group loses the small figures at it — which are exactly the point of a scale comparison.
const HERO_SET = ['sue', 'struthiomimus-altus', 'protoceratops-andrewsi'];
const HERO_W = 1400;
const heroItems = HERO_SET.map((s) => seen.get(s)).filter(Boolean).sort((a, b) => b.widthM - a.widthM);
let heroSvg = '';
if (heroItems.length) {
  const pxm = HERO_W / Math.max(...heroItems.map((i) => i.widthM));
  const drawn = heroItems.map((it) => {
    const s = (pxm * it.widthM) / it.w;
    return { it, s, sw: it.w * s, sh: it.h * s };
  });
  const hScale = (1.8 * pxm) / human.h;
  const hH = human.h * hScale;
  const H = Math.ceil(Math.max(...drawn.map((d) => d.sh), hH)) + 8;
  const parts = drawn.map(
    (d) =>
      `<path d="${d.it.path}" transform="translate(${(HERO_W - d.sw).toFixed(1)} ${(H - 4 - d.sh).toFixed(1)}) scale(${d.s.toFixed(5)})"/>`,
  );
  parts.push(
    `<g transform="translate(${(HERO_W * 0.02).toFixed(1)} ${(H - 4 - hH).toFixed(1)}) scale(${hScale.toFixed(5)})"><path d="${human.path}"/></g>`,
  );
  heroSvg = `<svg viewBox="0 0 ${HERO_W} ${H}" aria-hidden="true" focusable="false"><g fill="currentColor" fill-rule="evenodd">${parts.join('')}</g></svg>`;
}

// Dark until COMPARE_LIVE flips in src/lib/flags.mjs, which also drives the sitemap exclusion and
// every entry point. The page is live and returns 200, and being unlinked is NOT protection: it was
// listed in sitemap-0.xml, which was submitted to Search Console, so Google had been invited to crawl
// it. noindex (not a robots.txt Disallow) is the right tool — a Disallow would stop the crawl before
// Google could read the directive, which is the same trap noted in functions/_middleware.js.
const UNSHIPPED = !COMPARE_LIVE;

const title = 'Size comparison — build your own | Skeletal Drawing';
const description =
  'Pick any two to five extinct animals and see them drawn to a single scale, with a human for reference — measured from the same skeletal reconstructions used across the site.';
---

<BaseLayout title={title} description={description}>
  {UNSHIPPED && (
    <Fragment slot="head">
      <meta name="robots" content="noindex, follow" />
    </Fragment>
  )}
  <main class="wrap">
    <div class="head-band">
    {heroSvg && <div class="hero-sil" aria-hidden="true" set:html={heroSvg} />}
    <header class="head">
      <p class="eyebrow">Tools</p>
      <h1 class="display">Size comparison</h1>
      <p class="intro">
        Pick one to five animals and see them drawn to a single scale — tails aligned, feet on a common
        ground line, with a 1.8&nbsp;m human for reference. Every silhouette comes from the measured
        reconstructions used across the site. <span class="beta">More animals are added as the library grows.</span>
      </p>
    </header>
    </div>

    {/* The plate leads. It used to sit last, and the chooser above it ran past a viewport on every
        breakpoint — y≈871 on desktop, y≈1079 on a 812px phone — so the page opened on a form rather
        than on the thing it makes. Capping the picker height was not enough; the header, filters,
        search, count and controls still stacked past the fold. Result first, controls beneath it,
        chooser last: every adjustment now changes something already on screen. */}
    {/* Claim on top, drawing in the middle, numbers at the foot. The sentence and the lengths used to
        sit together below the plate and read as one block of text; split apart, the sentence titles
        the figure and the lengths become its key. Largest-vs-smallest keeps the title one clause long
        whether two animals are selected or five. */}
    <section class="stage-sec" aria-label="Comparison">
      <h2 class="readout" id="readout" hidden={!defaultReadout} set:html={defaultReadout} />
      <div class="stage" id="stage"></div>
      <p class="hint" id="hint">Choose animals below to build a comparison.</p>
      <div class="legend" id="legend"></div>
    </section>

    <div class="controls">
      <label class="toggle"><input type="checkbox" id="human-toggle" checked /> Humans for scale</label>
      {/* The rest of the site appends imperial in parentheses — "26 m (85 feet)". That cannot work
          here, because the ruler needs a tick spacing and metres and feet want different ones. So this
          page toggles instead. Metric leads, as it does everywhere else. */}
      <div class="units" role="group" aria-label="Units">
        <button type="button" class="unit on" data-units="m" aria-pressed="true">Meters</button>
        <button type="button" class="unit" data-units="ft" aria-pressed="false">Feet</button>
      </div>
      <span class="spacer"></span>
      <button type="button" class="ctl" id="clear">Clear</button>
      <button type="button" class="ctl" id="copy">Copy link</button>
      <button type="button" class="ctl ctl-go" id="download">Download image</button>
      <span class="copied" id="copied" hidden>Link copied</span>
    </div>

    <section class="picker-sec" aria-label="Choose animals">
      {/* Selected row sits ABOVE the filters and never filters out. Without it, narrowing the list
          would appear to discard picks that are still active — the single worst failure mode of a
          filtered multi-select. */}
      <div class="chosen-row" id="chosen-row" hidden>
        <span class="chosen-lbl">Comparing</span>
        <div class="chosen" id="chosen"></div>
      </div>

      {/* Mobile only: the facet rows cost ~180px at phone width, pushing the comparison to y≈1078 —
          past a whole screen of chooser before the page does its job. Search stays out, because it is
          how someone arrives with a specific animal in mind. Desktop shows everything (113px is cheap
          and hiding the main affordance would hurt discovery more than it saves). */}
      <button type="button" class="filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="facets">
        Filters<span class="ft-caret" aria-hidden="true">▾</span>
      </button>

      <div class="filters">
        <label class="search">
          <span class="vh">Search animals</span>
          <input type="search" id="q" placeholder={`Search ${catalog.length} animals…`} autocomplete="off" spellcheck="false" />
        </label>

        <div class="facets" id="facets">
        <div class="facet-row" role="group" aria-label="Filter by group">
          <button type="button" class="facet on" data-facet="gallery" data-val="" aria-pressed="true">All</button>
          {galleryFacets.map((g) => (
            <button type="button" class="facet" data-facet="gallery" data-val={g.id} aria-pressed="false">
              {g.label}<span class="facet-n">{g.n}</span>
            </button>
          ))}
        </div>

        {galleryFacets.map((g) => (
          <div class="facet-row sub" data-sub={g.id} hidden role="group" aria-label={`Filter within ${g.label}`}>
            <button type="button" class="facet sub-all on" data-facet="clade" data-val="" aria-pressed="true">All {g.label}</button>
            {subFacets[g.id].map((c) => (
              <button type="button" class="facet" data-facet="clade" data-val={c.id} aria-pressed="false">
                {c.id}<span class="facet-n">{c.n}</span>
              </button>
            ))}
          </div>
        ))}

        <div class="facet-row" role="group" aria-label="Filter by size">
          <button type="button" class="facet on" data-facet="size" data-val="" aria-pressed="true">Any size</button>
          {SIZE_BANDS.map((b) => (
            <button type="button" class="facet" data-facet="size" data-val={b.id} data-lo={String(b.lo)} data-hi={String(b.hi)} aria-pressed="false">
              {b.label}<span class="facet-n">{b.n}</span>
            </button>
          ))}
        </div>
        </div>
      </div>

      <p class="count" id="count" aria-live="polite"></p>
      {/* At the cap every unselected chip disables itself. Without a word of explanation that reads
          as the page breaking, not as a limit — 259 controls going dead at once. */}
      <p class="cap-note" id="cap-note" role="status" hidden>Five at a time — remove one to add another.</p>

      <div class="picker" id="picker">
        {catalog.map((a) => (
          <button
            type="button"
            class="chip"
            data-id={a.id}
            data-gallery={a.gallery}
            data-clades={a.clades.join('|')}
            data-len={a.lengthM}
            data-name={`${a.label} ${a.taxon}`.toLowerCase()}
            aria-pressed="false"
          >
            <span class="chip-name">
              {splitName(a).sci && <em>{splitName(a).sci}</em>}{splitName(a).rest}
            </span>
            <span class="chip-len">{a.lengthM} m</span>
          </button>
        ))}
      </div>
    </section>

    <noscript>
      <p class="noscript">This comparison tool needs JavaScript. Every animal is also shown to scale on its own page and on the genus hubs.</p>
    </noscript>
  </main>
</BaseLayout>

<script type="application/json" id="catalog" is:inline set:html={JSON.stringify(catalog)}></script>
<script type="application/json" id="cfg" is:inline set:html={JSON.stringify({ def: defaultSel, adultCx })}></script>
<script type="application/json" id="human" is:inline set:html={JSON.stringify(human)}></script>

<script is:inline>
  (() => {
    const catalog = JSON.parse(document.getElementById('catalog').textContent);
    const cfg = JSON.parse(document.getElementById('cfg').textContent);
    const ADULT_CX = typeof cfg.adultCx === 'number' ? cfg.adultCx : 0.5;
    const human = JSON.parse(document.getElementById('human').textContent);
    const byId = Object.fromEntries(catalog.map((a) => [a.id, a]));
    const MAX = 5;
    // Target viewBox width. The plate's furniture — ruler caption, tick labels, the human label and
    // the gaps between them — is fixed in USER units, but the viewBox was a fixed 100 px per metre and
    // therefore changed width with the selection, then got scaled to fit its container. So the
    // furniture rendered at whatever that scale happened to be: 59 px for two small birds, 4.6 px for
    // a Supersaurus plate — a 13x swing, illegible at one end and overbearing at the other, and it
    // pushed the caption visibly away from the ground line on small selections.
    //
    // Holding the viewBox width roughly constant instead, and solving for px-per-metre, fixes both:
    // every plate is scaled by about the same amount, so fixed user units mean a fixed rendered size.
    // 1500 is near where the old scale already sat for a mid-sized pair, so typical plates are
    // unchanged. The animals still scale by widthM against each other — only the coordinate space
    // moves, so nothing about the comparison itself changes.
    const TARGET_VB = 1500;
    const HUMAN_W_M = (human.w / human.h) * 1.8; // the adult+child group is ~1.43 m wide at 1.8 m tall
    // Shared with ScaleComparison.astro — keep in step. Hue/sat drive the lightness ramp; the
    // coverage band maps "how much of the shape behind do I cover" onto fill opacity, anchored to
    // length difference via coverage ~= (length ratio)^2: .90 ~ 5% shorter, .50 ~ 29% shorter.
    const RAMP_HUE = 34, RAMP_SAT = 58;
    const OP_BLEND = 0.75, OP_SOLID = 1, COVER_LO = 0.5, COVER_HI = 0.9;
    // Human scale reference: the owner's adult + child silhouette, adult scaled to 1.8 m. Derived per
    // render now, since px-per-metre is no longer a constant.

    // ---- units ----------------------------------------------------------------------------------
    // A port of formatImperial() from lib/schema.ts — deliberately the same rules, so a length reads
    // identically here and on the taxon's own page: inches under 2 ft, half-feet under 6, whole feet
    // above. KEEP IN STEP with that function.
    let units = 'm';
    const feetOf = (m) => m * 3.28084;
    const fmtImperial = (m) => {
      const inch = Math.round(m * 39.3701);
      if (inch < 24) return `${inch} in`;
      const ftExact = feetOf(m);
      const ft = ftExact < 6 ? Math.round(ftExact * 2) / 2 : Math.round(ftExact);
      return `${ft % 1 ? ft.toFixed(1) : ft} ft`;
    };
    const fmtLen = (m) => (units === 'ft' ? fmtImperial(m) : `${+m.toFixed(2)} m`);

    const stage = document.getElementById('stage');
    const legend = document.getElementById('legend');
    const hint = document.getElementById('hint');
    const readout = document.getElementById('readout');
    const capNote = document.getElementById('cap-note');
    const humanToggle = document.getElementById('human-toggle');
    const chips = [...document.querySelectorAll('.chip')];
    let selected = [];
    let lastPlate = null; // { inner, vbW, vbH } — the current plate, for the export
    let lastPainted = []; // legend rows with their resolved fill/stroke, for the export

    // Mirror of the server-side splitName: italicise the binomial only, so "— Scotty" and catalog
    // numbers stay roman. Labels are built from our own content, but escape anyway — this is the one
    // place catalog text becomes innerHTML.
    const esc = (t) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
    const nameHtml = (a) =>
      a.taxon && a.label.startsWith(a.taxon)
        ? `<em>${esc(a.taxon)}</em>${esc(a.label.slice(a.taxon.length))}`
        : esc(a.label);

    const fromUrl = () => {
      const p = new URLSearchParams(location.search).get('ids');
      return p ? p.split(',').filter((id) => byId[id]).slice(0, MAX) : [];
    };
    const toUrl = () => {
      const u = new URL(location.href);
      if (selected.length) u.searchParams.set('ids', selected.join(','));
      else u.searchParams.delete('ids');
      if (units === 'ft') u.searchParams.set('units', 'ft');
      else u.searchParams.delete('units');
      history.replaceState(null, '', u);
    };
    // ---- filtering ----------------------------------------------------------------------------
    // 262 chips in one flat list is unusable, so the picker is filtered rather than paged: search,
    // group, sub-clade and size all narrow the SAME list. Chips are hidden, never removed, so the
    // selection is untouched by filtering and a cleared filter restores instantly.
    const SIZE_BANDS = { xs: [0, 1], s: [1, 3], m: [3, 10], l: [10, 20], xl: [20, Infinity] };
    const q = document.getElementById('q');
    const countEl = document.getElementById('count');
    const chosenRow = document.getElementById('chosen-row');
    const chosenEl = document.getElementById('chosen');
    const filter = { text: '', gallery: '', clade: '', size: '' };

    const applyFilter = () => {
      const t = filter.text.trim().toLowerCase();
      let shown = 0;
      for (const c of chips) {
        const band = filter.size ? SIZE_BANDS[filter.size] : null;
        const len = +c.dataset.len;
        const ok =
          (!t || c.dataset.name.includes(t)) &&
          (!filter.gallery || c.dataset.gallery === filter.gallery) &&
          (!filter.clade || ('|' + c.dataset.clades + '|').includes('|' + filter.clade + '|')) &&
          (!band || (len >= band[0] && len < band[1]));
        c.hidden = !ok;
        if (ok) shown++;
      }
      // The sub-clade row only exists once its parent group is chosen — otherwise the second tier
      // would present ~40 chips before the reader has narrowed anything.
      for (const row of document.querySelectorAll('.facet-row.sub'))
        row.hidden = row.dataset.sub !== filter.gallery;
      const active = filter.text || filter.gallery || filter.clade || filter.size;
      countEl.textContent = active
        ? `${shown} of ${chips.length} animals` + (shown === 0 ? ' — try widening the filters' : '')
        : `${chips.length} animals`;
    };

    const setFacet = (kind, val) => {
      filter[kind] = val;
      if (kind === 'gallery') filter.clade = ''; // sub-clades belong to a group; changing group clears them
      for (const b of document.querySelectorAll('.facet')) {
        if (b.dataset.facet !== kind) continue;
        if (kind === 'clade' && b.closest('.facet-row.sub')?.dataset.sub !== filter.gallery) continue;
        const on = (b.dataset.val || '') === val;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      if (kind === 'gallery')
        for (const b of document.querySelectorAll('.facet[data-facet="clade"]')) {
          const on = !b.dataset.val;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', String(on));
        }
      applyFilter();
    };

    // Selected chips are mirrored above the filters, each removable, so a narrowed list never hides
    // what is currently being compared.
    const renderChosen = () => {
      chosenRow.hidden = selected.length === 0;
      chosenEl.innerHTML = selected
        .map((id) => {
          const a = byId[id];
          return a
            ? `<button type="button" class="chosen-chip" data-drop="${id}" title="Remove ${a.label}">` +
              `${a.label}<span class="x" aria-hidden="true">×</span>` +
              `<span class="vh">remove</span></button>`
            : '';
        })
        .join('');
    };

    const syncChips = () => {
      const atCap = selected.length >= MAX;
      chips.forEach((c) => {
        const on = selected.includes(c.dataset.id);
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', String(on));
        c.disabled = !on && atCap;
      });
      capNote.hidden = !atCap;
    };

    function render() {
      syncChips();
      renderChosen();
      const items = selected.map((id) => byId[id]).filter(Boolean).sort((a, b) => b.lengthM - a.lengthM);
      if (!items.length) {
        stage.innerHTML = '';
        legend.innerHTML = '';
        hint.hidden = false;
        // Reset here too: this branch returns early, so without it Clear leaves the previous
        // comparison's sentence sitting under an empty plate.
        readout.hidden = true;
        return;
      }
      hint.hidden = true;
      const showHuman = humanToggle.checked;
      const padL = 16,
        padT = 16;
      const humanGapU = 40, rightGutter = 30;
      // Solve px-per-metre so the viewBox lands on TARGET_VB:
      //   vbW = padL + PXM*widthM + [humanGapU + PXM*HUMAN_W_M] + rightGutter
      const widestM = Math.max(...items.map((i) => i.widthM));
      const fixedU = padL + rightGutter + (showHuman ? humanGapU : 0);
      const PXM = (TARGET_VB - fixedU) / (widestM + (showHuman ? HUMAN_W_M : 0));
      const humanH = 1.8 * PXM,
        humanScale = humanH / human.h,
        humanW = +(human.w * humanScale).toFixed(1);
      // Scale by the silhouette's horizontal extent, not its along-body length — otherwise an
      // upright taxon (raised neck, therizinosaur, bird) is drawn as wide as it is long. sw then
      // equals PXM * widthM, so the metre ruler below stays exact.
      const scaled = items.map((it, idx) => {
        const s = (PXM * it.widthM) / it.w;
        return { it, idx, s, sw: it.w * s, sh: it.h * s };
      });
      const maxLen = Math.max(...items.map((i) => i.lengthM)); // biological, for the label
      const maxSW = Math.max(...scaled.map((d) => d.sw));      // geometric, for the layout
      const maxSH = Math.max(...scaled.map((d) => d.sh), showHuman ? humanH : 0);
      const guideX = padL + maxSW,
        groundY = padT + maxSH;
      const humanX = guideX + humanGapU;
      // Ruler spans the drawn extent, not the biological length — otherwise the ticks run off the
      // left edge whenever the widest animal is posture-shortened (widthM < lengthM).
      // Tick spacing per unit. Metric keeps its shipped 1 m step with a major every 5. Feet need their
      // own: a 26 m animal is 85 ft, so a 1 ft step would draw 85 ticks — dense to the point of being a
      // grey band. Below ~12 ft the coarse step would draw none, so it falls back.
      const ftTotal = feetOf(maxSW / PXM);
      const step = units === 'ft' ? (ftTotal < 12 ? 1 : 5) : 1;
      let majorEvery = units === 'ft' ? (ftTotal < 12 ? 5 : 10) : 5;
      const unitPx = units === 'ft' ? PXM / 3.28084 : PXM; // px per foot / per metre
      const marks = Math.floor((units === 'ft' ? ftTotal : maxSW / PXM) / step);
      // With few ticks the "major" rule labelled almost none of them — a 3 m plate drew ticks at 1, 2
      // and 3 m but a lone "0" beneath them, which is a ruler with no numbers on it.
      if (marks <= 6) majorEvery = 1;
      const rulerY = groundY + 20;
      const rightPad = (showHuman ? humanGapU + humanW : 0) + rightGutter;
      const vbW = Math.round(guideX + rightPad),
        vbH = Math.round(rulerY + 22);

      let s = `<svg viewBox="0 0 ${vbW} ${vbH}" role="img" aria-label="Scale comparison of ${items.length} animals, largest ${maxLen} meters">`;
      s += `<line x1="${padL}" y1="${groundY}" x2="${showHuman ? humanX + humanW : guideX}" y2="${groundY}" class="c-ground"/>`;
      for (let i = 0; i <= marks; i++) {
        const v = i * step;
        const x = guideX - v * unitPx;
        const major = v % majorEvery === 0;
        s += `<line x1="${x}" y1="${groundY}" x2="${x}" y2="${groundY + (major ? 8 : 4)}" class="c-tick${major ? ' major' : ''}"/>`;
        if (major) s += `<text x="${x}" y="${rulerY + 6}" class="c-ticklabel">${v}</text>`;
      }
      // "meters of ground covered", not "meters from tail tip". The ruler measures the DRAWN
      // horizontal extent, which need not equal the legend's along-body length: a raised-neck sauropod
      // covers less ground than its length (Patagotitan, 28 m long, 22.4 m of ground), while tusks, a
      // beak or a folded wing push the other way (Mammut, 5 m long, 5.87 m of ground). An explanatory
      // note was tried and dropped — it could only describe one direction, and the ruler is a reading
      // aid for the drawing rather than a measurement of the animal. The label carries that on its own.
      s += `<text x="${guideX - marks * step * unitPx}" y="${rulerY + 19}" class="c-unit">${units === 'ft' ? 'feet' : 'meters'} of ground covered</text>`;
      // Gold-tint ramp + adaptive opacity, matching ScaleComparison.astro (the hub treatment is
      // canonical). Largest = lightest and painted first (back) -> smallest = darkest and in front.
      // Opacity comes from how much of the shape BEHIND each silhouette it covers: near-equal sizes
      // must blend or the one behind disappears; a clearly smaller animal hides almost nothing and
      // reads better solid. See ScaleComparison for the coverage<->length-difference mapping.
      let smallestBehind = Infinity;
      const painted = scaled.map((d) => {
        const t = scaled.length > 1 ? d.idx / (scaled.length - 1) : 0.4;
        const L = Math.round(68 - t * 38);
        const area = d.sw * d.sh;
        const coverage = smallestBehind === Infinity ? 0 : Math.min(area / smallestBehind, 1);
        smallestBehind = Math.min(smallestBehind, area);
        const k = Math.min(Math.max((coverage - COVER_LO) / (COVER_HI - COVER_LO), 0), 1);
        const fillOpacity = +(OP_SOLID + (OP_BLEND - OP_SOLID) * k).toFixed(3);
        return {
          ...d, fillOpacity,
          fill: `hsl(${RAMP_HUE} ${RAMP_SAT}% ${L}%)`,
          stroke: `hsl(${RAMP_HUE} ${RAMP_SAT + 8}% ${Math.max(L - 18, 16)}%)`,
          swatch: `hsl(${RAMP_HUE} ${RAMP_SAT}% ${L}% / ${fillOpacity})`,
        };
      });
      painted.forEach((d) => {
        const tx = `translate(${(guideX - d.sw).toFixed(1)} ${(groundY - d.sh).toFixed(1)}) scale(${d.s.toFixed(4)})`;
        s += `<path d="${d.it.path}" transform="${tx}" fill="${d.fill}" fill-opacity="${d.fillOpacity}" fill-rule="evenodd" stroke="${d.stroke}" stroke-width="1.2" stroke-opacity="0.9" vector-effect="non-scaling-stroke"/>`;
      });
      s += `<line x1="${guideX}" y1="${padT}" x2="${guideX}" y2="${groundY}" class="c-guide"/>`;
      if (showHuman) {
        s += `<g transform="translate(${humanX} ${groundY - humanH}) scale(${humanScale.toFixed(4)})"><path d="${human.path}" class="c-human"/></g>`;
        // Parenthesised and explicitly "tall": every other number on the plate — the ruler, the
        // legend, the title — is a length, so a bare "1.8 m" under the figure reads as one more of
        // them. The brackets set it apart as an aside about the reference figure.
        // Sits under the ADULT (ADULT_CX, measured off the artwork server-side), not under the middle
        // of the pair, where it would appear to caption the child too.
        s += `<text x="${(humanX + humanW * ADULT_CX).toFixed(1)}" y="${groundY + 14}" class="c-humanlabel" text-anchor="middle">(${fmtLen(1.8)} tall)</text>`;
      }
      s += `</svg>`;
      stage.innerHTML = s;
      // Kept for the export, which recomposes the plate inside a titled, credited image rather than
      // re-deriving the geometry. `s` already carries the <svg> wrapper, so the inner content is what
      // gets translated into the export's layout.
      lastPlate = { inner: s.replace(/^<svg[^>]*>/, '').replace(/<\/svg>$/, ''), vbW, vbH };
      // Swatches carry the same alpha the plate renders, on the same background, so the key shows
      // what is actually drawn rather than the fill at full strength.
      lastPainted = painted;
      legend.innerHTML = painted
        .map(
          (d) =>
            `<span class="leg"><span class="leg-sw" style="background:${d.swatch};border:1px solid ${d.stroke}"></span><span class="leg-name">${nameHtml(d.it)}</span><span class="leg-len">${fmtLen(d.it.lengthM)}</span></span>`,
        )
        .join('');

      // The plate's title. Always largest vs smallest, so it stays one clause whether two animals are
      // selected or five. KEEP IN STEP with the server-rendered `defaultReadout` in the frontmatter,
      // which paints this same sentence for the default selection before the script runs.
      if (items.length === 1) {
        // A single animal is a legitimate use — "how big was this thing?" — so it gets a title of its
        // own rather than a blank space where the comparison sentence would be.
        readout.innerHTML = `${nameHtml(items[0])} is ${fmtLen(items[0].lengthM)} long`;
        readout.hidden = false;
      } else if (items.length >= 2) {
        const big = items[0], small = items[items.length - 1];
        const ratio = big.lengthM / small.lengthM;
        // Kept as a string: +(2.047).toFixed(1) coerces back to 2 and prints "2×", dropping the one
        // decimal that says how precise the claim is. Above 10× the decimal is false precision.
        const n = ratio >= 10 ? String(Math.round(ratio)) : ratio.toFixed(1);
        readout.innerHTML =
          ratio >= 1.05
            ? `${nameHtml(big)} is ${n}× the length of ${nameHtml(small)}`
            : `${nameHtml(big)} and ${nameHtml(small)} are within a few percent of the same length`;
        readout.hidden = false;
      } else {
        readout.hidden = true;
      }
    }

    const toggle = (id) => {
      const i = selected.indexOf(id);
      if (i >= 0) selected.splice(i, 1);
      else {
        if (selected.length >= MAX) return;
        selected.push(id);
      }
      toUrl();
      render();
    };

    chips.forEach((c) => c.addEventListener('click', () => toggle(c.dataset.id)));
    humanToggle.addEventListener('change', render);

    q.addEventListener('input', () => { filter.text = q.value; applyFilter(); });

    // Units. Every number on the page is derived from metres held in the catalogue, so switching is a
    // re-render plus a relabel of the chips and size bands — nothing is stored converted.
    const relabelUnits = () => {
      for (const c of chips) {
        const el = c.querySelector('.chip-len');
        if (el) el.textContent = fmtLen(+c.dataset.len);
      }
      for (const b of document.querySelectorAll('.facet[data-facet="size"]')) {
        const lo = b.dataset.lo, hi = b.dataset.hi;
        if (lo == null) continue; // the "Any size" chip
        const n = b.querySelector('.facet-n')?.outerHTML ?? '';
        // Band edges use whole feet, not fmtLen: these are filter boundaries, and fmtLen's half-foot
        // rule (meant for animal lengths) turned the 1 m edge into "3.5 ft". The bounds themselves stay
        // metric, so the counts are unchanged by the toggle — only the labels convert.
        const e = (v) => (units === 'ft' ? `${Math.round(feetOf(v))} ft` : `${v} m`);
        const txt =
          hi === 'Infinity' ? `${e(+lo)} +`
          : lo === '0' ? `Under ${e(+hi)}`
          : `${units === 'ft' ? Math.round(feetOf(+lo)) : +lo}–${e(+hi)}`;
        b.innerHTML = txt + n;
      }
    };
    const setUnits = (u) => {
      units = u === 'ft' ? 'ft' : 'm';
      for (const b of document.querySelectorAll('.unit')) {
        const on = b.dataset.units === units;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      relabelUnits();
      try { localStorage.setItem('sd-units', units); } catch (e) {} // private mode / blocked storage
      toUrl();
      render();
    };
    for (const b of document.querySelectorAll('.unit'))
      b.addEventListener('click', () => setUnits(b.dataset.units));

    // Facets collapse on phones only. `hidden` is set from JS rather than the markup so the panel is
    // open by default for anyone without JS, and desktop CSS ignores the attribute entirely.
    const ftog = document.getElementById('filters-toggle');
    const facets = document.getElementById('facets');
    const isPhone = () => matchMedia('(max-width: 700px)').matches;
    const syncFacets = (open) => {
      ftog.setAttribute('aria-expanded', String(open));
      facets.hidden = isPhone() && !open;
    };
    ftog.addEventListener('click', () => syncFacets(ftog.getAttribute('aria-expanded') !== 'true'));
    // A viewport crossing the breakpoint must not strand the panel hidden on desktop.
    matchMedia('(max-width: 700px)').addEventListener('change', () =>
      syncFacets(ftog.getAttribute('aria-expanded') === 'true'));
    syncFacets(false);
    for (const b of document.querySelectorAll('.facet'))
      b.addEventListener('click', () => setFacet(b.dataset.facet, b.dataset.val || ''));
    // Delegated: the chosen row is re-rendered on every change, so per-chip listeners would leak.
    chosenEl.addEventListener('click', (e) => {
      const b = e.target.closest('[data-drop]');
      if (b) toggle(b.dataset.drop);
    });
    document.getElementById('clear').addEventListener('click', () => {
      selected = [];
      toUrl();
      render();
    });
    // ---- export ---------------------------------------------------------------------------------
    // A downloaded image leaves the site permanently, exactly like a scraped skeletal, so CLAUDE.md §3
    // applies to it: the credit carrying the domain and the scale reference must be ON the artwork.
    // That makes the export a composed picture — title, plate, key, credit — not a crop of the plate.
    //
    // Rasterising an SVG through <img> is where this usually goes wrong twice over, and both traps are
    // handled below:
    //   1. A detached SVG resolves no CSS variables and inherits no page stylesheet, so the plate's
    //      classes would render unstyled and every var() would come out empty. Colours are read off
    //      the live page and written into the export as literals.
    //   2. An SVG loaded as an image cannot fetch anything, web fonts included, so text would silently
    //      fall back. The three faces actually used are fetched (already cached — same origin) and
    //      inlined as data URIs. ~287 KB, alive only for the moment it takes to draw.
    const FONTS = [
      { file: '/fonts/newsreader-roman-latin.woff2', family: 'Newsreader', style: 'normal', weight: 400 },
      { file: '/fonts/newsreader-italic-latin.woff2', family: 'Newsreader', style: 'italic', weight: 400 },
      { file: '/fonts/plexmono-400-latin.woff2', family: 'IBM Plex Mono', style: 'normal', weight: 400 },
    ];
    let fontCss = null;
    const loadFontCss = async () => {
      if (fontCss !== null) return fontCss;
      const parts = await Promise.all(
        FONTS.map(async (f) => {
          const buf = await (await fetch(f.file)).arrayBuffer();
          let bin = '';
          const bytes = new Uint8Array(buf);
          for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
          return `@font-face{font-family:'${f.family}';font-style:${f.style};font-weight:${f.weight};` +
                 `src:url(data:font/woff2;base64,${btoa(bin)}) format('woff2');}`;
        }),
      );
      fontCss = parts.join('');
      return fontCss;
    };

    const cssVar = (n, fallback) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(n).trim();
      return v || fallback;
    };

    // Greedy wrap over styled runs, measured with the real faces via canvas.
    const measurer = document.createElement('canvas').getContext('2d');
    // Advance by INK EXTENT, not advance width. An italic serif leans past its own advance —
    // "Tyrannosaurus rex" at 22px measures 157.5 wide but inks to 159.4 — so laying the next run at
    // the advance lets the final letter lean into the following space. With a 4.9px space that left a
    // 3px gap, and closed it entirely wherever the space was lost, printing "rex— Scotty".
    const runW = (font, t) => {
      measurer.font = font;
      const m = measurer.measureText(t);
      return Math.max(m.width, m.actualBoundingBoxRight || 0);
    };
    const wrapRuns = (runs, font, maxW) => {
      const words = [];
      for (const r of runs)
        for (const w of r.t.split(/(\s+)/)) if (w.length) words.push({ t: w, i: r.i });
      const lines = [[]];
      let w = 0;
      for (const word of words) {
        const ww = runW(`${word.i ? 'italic ' : ''}${font}`, word.t);
        if (w + ww > maxW && lines[lines.length - 1].length && word.t.trim()) {
          lines.push([]);
          w = 0;
        }
        if (!word.t.trim() && !lines[lines.length - 1].length) continue; // no leading space on a new line
        lines[lines.length - 1].push(word);
        w += ww;
      }
      return lines.filter((l) => l.length);
    };

    const exportPng = async () => {
      if (!lastPlate || !lastPainted.length) return;
      const ink = cssVar('--ink', '#1b1b1b'),
        slate = cssVar('--slate', '#5b5b5b'),
        plateBg = cssVar('--plate', '#faf8f4'),
        hair = cssVar('--hair', '#e2ded6'),
        measure = cssVar('--measure', '#8a8378'),
        accent = cssVar('--accent', '#b8791f');

      const W = 1600;
      const PAD = 64;
      const inW = W - PAD * 2;
      const TITLE_SIZE = 42, TITLE_LH = 54;

      // title
      const runs = [];
      for (const node of readout.childNodes)
        runs.push({ t: node.textContent, i: node.nodeName === 'EM' });
      const titleLines = readout.hidden ? [] : wrapRuns(runs, `${TITLE_SIZE}px Newsreader, Georgia, serif`, inW);

      let y = PAD;
      let body = '';
      for (const line of titleLines) {
        y += TITLE_LH;
        const tf = (wd) => `${wd.i ? 'italic ' : ''}${TITLE_SIZE}px Newsreader, Georgia, serif`;
        const total = line.reduce((n, wd) => n + runW(tf(wd), wd.t), 0);
        let x = PAD + (inW - total) / 2;
        for (const wd of line) {
          body += `<text x="${x.toFixed(1)}" y="${y}" class="x-title"${wd.i ? ' font-style="italic"' : ''}>${esc(wd.t)}</text>`;
          x += runW(tf(wd), wd.t);
        }
      }

      // plate, scaled to the content width
      const pScale = inW / lastPlate.vbW;
      const pH = lastPlate.vbH * pScale;
      y += titleLines.length ? 44 : 0;
      body += `<g transform="translate(${PAD} ${y.toFixed(1)}) scale(${pScale.toFixed(5)})">${lastPlate.inner}</g>`;
      y += pH + 46;

      // key — swatch, name, length; centred as a row
      const LEG = 22;
      const segs = lastPainted.map((d) => {
        const { sci, rest } = (() => {
          const a = d.it;
          const split =
            a.taxon && a.label.startsWith(a.taxon)
              ? { sci: a.taxon, rest: a.label.slice(a.taxon.length) }
              : { sci: '', rest: a.label };
          // SVG <text> strips leading whitespace, but measureText counts it — so " — Scotty" is
          // positioned as though the space were there and then drawn without it, closing the gap to
          // "rex— Scotty". A non-breaking space is never collapsed, and measures the same.
          return { ...split, rest: split.rest.replace(/^[ \t]+/, (m) => ' '.repeat(m.length)) };
        })();
        const wSci = sci ? runW(`italic ${LEG}px Newsreader, Georgia, serif`, sci) : 0;
        const wRest = runW(`${LEG}px Newsreader, Georgia, serif`, rest);
        const lenT = fmtLen(d.it.lengthM);
        const wLen = runW(`${LEG - 4}px 'IBM Plex Mono', monospace`, lenT);
        return { d, sci, rest, wSci, wRest, lenT, wLen, w: 34 + wSci + wRest + 12 + wLen };
      });
      // Wrap into rows. Five long binomials — the catalogue has several past 30 characters — overrun a
      // single line and clip the right edge of the image.
      const gapL = 40, LEG_LH = 34;
      const rows = [[]];
      for (const s of segs) {
        const row = rows[rows.length - 1];
        const wWith = row.reduce((n, r) => n + r.w, 0) + gapL * row.length + s.w;
        if (row.length && wWith > inW) rows.push([s]);
        else row.push(s);
      }
      body += `<line x1="${PAD}" y1="${(y - 26).toFixed(1)}" x2="${W - PAD}" y2="${(y - 26).toFixed(1)}" stroke="${hair}" stroke-width="1"/>`;
      for (const row of rows) {
        const rowW = row.reduce((n, s) => n + s.w, 0) + gapL * (row.length - 1);
        let lx = PAD + Math.max(0, (inW - rowW) / 2);
        for (const s of row) {
          body += `<rect x="${lx.toFixed(1)}" y="${(y - 15).toFixed(1)}" width="26" height="14" rx="2" fill="${s.d.swatch}" stroke="${s.d.stroke}"/>`;
          let tx = lx + 34;
          if (s.sci) {
            body += `<text x="${tx.toFixed(1)}" y="${y}" class="x-leg" font-style="italic">${esc(s.sci)}</text>`;
            tx += s.wSci;
          }
          if (s.rest) {
            body += `<text x="${tx.toFixed(1)}" y="${y}" class="x-leg">${esc(s.rest)}</text>`;
            tx += s.wRest;
          }
          body += `<text x="${(tx + 12).toFixed(1)}" y="${y}" class="x-len">${esc(s.lenT)}</text>`;
          lx += s.w + gapL;
        }
        y += LEG_LH;
      }
      y += 12;
      body += `<text x="${W / 2}" y="${y}" class="x-credit" text-anchor="middle">© Scott Hartman · skeletaldrawing.com</text>`;
      const H = Math.round(y + PAD - 20);

      const css =
        `${await loadFontCss()}` +
        `.x-title{font-family:Newsreader,Georgia,serif;font-size:${TITLE_SIZE}px;fill:${ink};}` +
        `.x-leg{font-family:Newsreader,Georgia,serif;font-size:${LEG}px;fill:${ink};}` +
        `.x-len{font-family:'IBM Plex Mono',monospace;font-size:${LEG - 4}px;fill:${slate};}` +
        `.x-credit{font-family:'IBM Plex Mono',monospace;font-size:17px;fill:${measure};letter-spacing:.04em;}` +
        `.c-ground{stroke:${ink};stroke-width:1.5;}` +
        `.c-guide{stroke:${accent};stroke-width:1;stroke-dasharray:4 4;opacity:.55;}` +
        `.c-tick{stroke:${slate};stroke-width:1;}.c-tick.major{stroke:${ink};}` +
        `.c-ticklabel{font-family:'IBM Plex Mono',monospace;font-size:11px;fill:${slate};text-anchor:middle;}` +
        `.c-unit{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;fill:${measure};}` +
        `.c-human{fill:${slate};}` +
        `.c-humanlabel{font-family:'IBM Plex Mono',monospace;font-size:11px;fill:${slate};}`;

      const svg =
        `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">` +
        `<style>${css}</style><rect width="${W}" height="${H}" fill="${plateBg}"/>${body}</svg>`;

      const SCALE = 2; // a crisp image on a retina screen and usable in a talk
      const img = new Image();
      const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml;charset=utf-8' }));
      try {
        await new Promise((res, rej) => {
          img.onload = res;
          img.onerror = () => rej(new Error('svg render failed'));
          img.src = url;
        });
        const cv = document.createElement('canvas');
        cv.width = W * SCALE;
        cv.height = H * SCALE;
        const ctx = cv.getContext('2d');
        ctx.setTransform(SCALE, 0, 0, SCALE, 0, 0);
        ctx.drawImage(img, 0, 0);
        const blob = await new Promise((r) => cv.toBlob(r, 'image/png'));
        // Take whole slugs up to the budget rather than slicing the joined string, which cut mid-name
        // and produced "...-microraptor-gu". The first is always kept even if it alone exceeds the
        // budget — a long filename beats one that names nothing.
        const NAME_BUDGET = 80;
        const ids = [];
        let used = 0;
        for (const d of lastPainted) {
          const id = d.it.id;
          const cost = (ids.length ? 1 : 0) + id.length;
          if (ids.length && used + cost > NAME_BUDGET) break;
          ids.push(id);
          used += cost;
        }
        const name = `size-comparison-${ids.join('-')}-skeletaldrawing.png`;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = name;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      } finally {
        URL.revokeObjectURL(url);
      }
    };

    document.getElementById('download').addEventListener('click', async (e) => {
      const b = e.currentTarget;
      b.disabled = true;
      const was = b.textContent;
      b.textContent = 'Building…';
      try {
        await exportPng();
      } catch (err) {
        b.textContent = 'Export failed';
        setTimeout(() => (b.textContent = was), 2200);
        return;
      } finally {
        b.disabled = false;
      }
      b.textContent = was;
    });

    document.getElementById('copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        const c = document.getElementById('copied');
        c.hidden = false;
        setTimeout(() => (c.hidden = true), 1600);
      } catch (e) {}
    });

    selected = fromUrl();
    if (!selected.length) selected = (cfg.def || []).filter((id) => byId[id]).slice(0, MAX);
    // Units come from the URL first so a shared link lands in the sender's units, then from a previous
    // visit. Metric is the default and the fallback, matching the rest of the site.
    let startUnits = new URLSearchParams(location.search).get('units');
    if (startUnits !== 'ft' && startUnits !== 'm') {
      try { startUnits = localStorage.getItem('sd-units'); } catch (e) { startUnits = null; }
    }
    units = startUnits === 'ft' ? 'ft' : 'm';
    for (const b of document.querySelectorAll('.unit')) {
      const on = b.dataset.units === units;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    }
    relabelUnits();
    applyFilter(); // seeds the count and hides the sub-clade rows before first paint
    render();
  })();
</script>

