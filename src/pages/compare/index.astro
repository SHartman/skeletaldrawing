    border: 1px solid var(--ink); border-radius: 999px; padding: 6px 12px;
  }
  .chosen-chip .x { font-size: 15px; line-height: 1; opacity: .7; }
  .chosen-chip:hover { opacity: .86; }
  .chosen-chip:hover .x { opacity: 1; }

  .filters { display: grid; gap: 12px; margin-bottom: 14px; }
  .facets { display: grid; gap: 12px; }

  /* Desktop: no toggle, facets always shown. The rule flips at 700px. */
  .filters-toggle { display: none; }
  @media (max-width: 700px) {
